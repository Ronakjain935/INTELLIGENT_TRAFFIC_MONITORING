# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Database Configuration
SQLITE_DB_PATH=data/traffic_system.db
DATABASE_URL=sqlite:///data/traffic_system.db
# DATABASE_URL=postgresql://user:password@localhost:5432/traffic_db

# Model Inference Settings
MODEL_NAME=yolov8n.pt
MODEL_CONFIDENCE=0.40
MODEL_IOU=0.50
MODEL_DEVICE=auto

# Storage & Output Directories
REPORTS_DIR=data/reports
OUTPUT_VIDEO_DIR=data/output
SAMPLE_VIDEOS_DIR=data/input

# Application & Server Settings
APP_ENV=development
APP_PORT=8501
DEBUG=True
